# Production. Скопируйте в .env.production и заполните боевыми значениями.

# ── LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Supabase (prod-проект) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ── Auth ─────────────────────────────────────────────────────────────
# В production авторизация ДОЛЖНА быть включена.
AUTH_DISABLED=0

# ── App ──────────────────────────────────────────────────────────────
# OAuth redirectTo и post-auth redirects.
NEXT_PUBLIC_APP_URL=https://lingua-bloom.ru
PORT=3000

# ── Telegram (необязательно) ─────────────────────────────────────────
# Fallback для локальной разработки. В production учителя настраивают /settings/telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LangSmith (необязательно) ────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=lingua-bloom-prod
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_CALLBACKS_BACKGROUND=false
