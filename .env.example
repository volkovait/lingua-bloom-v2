# ── LLM (OpenAI-совместимый провайдер) ───────────────────────────────
# Работает с OpenAI, Polza.ai, OpenRouter и любым OpenAI-совместимым API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Необязательные оверрайды модели по ролям (иначе берётся OPENAI_MODEL):
# OPENAI_MODEL_CLASSIFY=
# OPENAI_MODEL_PLAN=
# OPENAI_MODEL_SPEC=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role ключ: серверные записи в обход RLS (НЕ префикс NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string для LangGraph checkpointer (Supabase → Connection string).
SUPABASE_DB_URL=

# ── Auth ─────────────────────────────────────────────────────────────
# Для локальной разработки — отключаем авторизацию.
AUTH_DISABLED=1
# UUID пользователя, под которым пишем в БД, когда авторизация отключена.
AUTH_DISABLED_IMPERSONATE_USER_ID=00000000-0000-0000-0000-000000000001

# ── App ──────────────────────────────────────────────────────────────
# OAuth redirectTo и post-auth redirects. Локально — localhost,
# в production (.env.production) — https://lingua-bloom.ru
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ── Telegram (необязательно) ─────────────────────────────────────────
# Fallback для локальной разработки, если учитель не настроил профиль в /settings/telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LangSmith (необязательно) ────────────────────────────────────────
# Трейсинг прогонов LangGraph: промпты, ответы узлов, токены, латентность.
# Ключ: https://smith.langchain.com → Settings → API Keys
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=lingua-bloom
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# В Next.js / serverless лучше false — трейс успеет уйти до конца запроса.
# LANGCHAIN_CALLBACKS_BACKGROUND=false
